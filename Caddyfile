{
	email you@example.com
}

# Both hostnames proxy to the same container; the application splits them by Host.
# The body cap sits above MAX_UPLOAD_BYTES so an oversized push is refused by the
# application with a JSON error rather than cut off at the edge, and the timeouts
# are raised because a 200MB upload over a slow link outlives Caddy's defaults.
mockups.example.com, panel.mockups.example.com {
	encode zstd gzip

	request_body {
		max_size 250MB
	}

	reverse_proxy app:3000 {
		transport http {
			read_timeout 600s
			write_timeout 600s
		}
	}
}
